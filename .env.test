# Test-only environment. Committed on purpose: it holds no secrets, and the suite must never be
# able to reach a real SMS provider or the development database.
DATABASE_URL=postgresql://postgres:devlocal@localhost:55432/atheneum_test?schema=public
SESSION_SECRET=test-session-secret-at-least-32-characters
NEXT_PUBLIC_STUDIO_TIMEZONE=America/Chicago

# Empty provider credentials keep sendSms() on the mock path; the tests that need a delivery
# failure mock the module instead of pointing at a real API.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=
GHL_API_TOKEN=
GHL_LOCATION_ID=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
