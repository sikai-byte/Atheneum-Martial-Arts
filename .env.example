DATABASE_URL="postgresql://postgres:devlocal@localhost:55432/atheneum?schema=public"
SESSION_SECRET="replace-with-a-random-string-at-least-32-characters-long"

# --- Lead follow-up bot ---------------------------------------------------
# Everything below is optional. Without it the bot still runs end to end:
# texts are recorded against each lead (provider "MOCK") but not delivered,
# and lead investigation falls back to the built-in rules engine.

# HighLevel / Gymnetics (preferred: texts from the number already on the sub-account).
# Ask Gymnetics for a private integration token scoped to conversations/message.write,
# conversations.write and contacts.write, plus the sub-account (location) ID.
# Takes priority over Twilio when both are set.
GHL_API_TOKEN=""
GHL_LOCATION_ID=""
# Shared secret for the inbound workflow webhook:
# /api/webhooks/ghl/inbound?secret=...
GHL_WEBHOOK_SECRET=""
# Only needed when the sub-account has several numbers and you must pin one.
# GHL_FROM_NUMBER="+13135550123"

# Twilio (outbound + inbound SMS). Use either a phone number or a messaging service.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# TWILIO_MESSAGING_SERVICE_SID=""
# Public origin used to validate Twilio's request signature behind a proxy.
# PUBLIC_BASE_URL="https://portal.atheneummartialarts.com"
# TWILIO_VALIDATE_SIGNATURE="false"   # local testing only

# Facebook Lead Ads webhook (Meta app → Webhooks → page leadgen subscription).
FB_VERIFY_TOKEN=""
FB_APP_SECRET=""
FB_PAGE_ACCESS_TOKEN=""
# FB_GRAPH_VERSION="v21.0"

# AI lead investigation (set one).
OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# LLM_MODEL="gpt-4o-mini"

# Shared secret for the follow-up dispatcher cron endpoint.
CRON_SECRET=""

# --- Dues ------------------------------------------------------------------
# Optional. Without this, dues are recorded by hand on the member page.
# With it, /api/webhooks/stripe ingests paid/failed invoices and cancellations.
STRIPE_WEBHOOK_SECRET=""
# Link texted to a member when their card fails, if the invoice has no hosted page.
# STRIPE_BILLING_PORTAL_URL=""
