generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   // MEMBER | PARENT | COACH | ADMIN
  householdId  String?
  household    Household? @relation(fields: [householdId], references: [id])
  profile      MemberProfile?
  orders       Order[]
  posts        Post[]
  comments     Comment[]
  resetTokens  PasswordResetToken[]
  createdAt    DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Household {
  id       String          @id @default(cuid())
  name     String
  users    User[]
  profiles MemberProfile[]
}

model MemberProfile {
  id              String   @id @default(cuid())
  name            String
  isChild         Boolean  @default(false)
  birthYear       Int?
  experienceLevel String   @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  weeklyGoal      Int      @default(3)
  membershipPlan  String?  // e.g. "Adult Unlimited", "Kids Monthly", "10-Class Punch Pass"
  membershipType  String?  // MONTHLY | PUNCH_PASS
  membershipRenewsAt DateTime?
  punchPassTotal  Int?
  punchPassUsed   Int      @default(0)
  photoType       String   @default("") // mime type of uploaded photo; empty = none
  photoUpdatedAt  DateTime?
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id])
  householdId     String
  household       Household @relation(fields: [householdId], references: [id])
  bookings        Booking[]
  attendances     Attendance[]
  milestones      Milestone[]
  memberships     Membership[]
  payments        Payment[]
  joinedAt        DateTime @default(now())
  leftAt          DateTime?
  leadId          String?  @unique // the lead this member came from, so attribution survives conversion
  lead            Lead?    @relation(fields: [leadId], references: [id])
}

/// A sellable membership (monthly dues or a punch pass). Prices are in cents.
model MembershipPlan {
  id            String       @id @default(cuid())
  name          String       @unique
  description   String       @default("")
  priceCents    Int
  billingPeriod String       @default("MONTHLY") // MONTHLY | ANNUAL | ONE_TIME
  classesPerWeek Int?        // null = unlimited
  punchPassClasses Int?      // set for punch passes instead of recurring dues
  active        Boolean      @default(true)
  sortOrder     Int          @default(0)
  stripePriceId String?      // set once dues are collected through Stripe Billing
  memberships   Membership[]
}

/// A member's enrolment on a plan. One active membership per profile at a time.
model Membership {
  id             String    @id @default(cuid())
  status         String    @default("ACTIVE") // ACTIVE | PAST_DUE | FROZEN | CANCELLED
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  cancelReason   String?
  priceCents     Int       // price at signup, so later plan changes don't rewrite history
  billingDay     Int?      // day of month dues are collected
  nextInvoiceAt  DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  profileId      String
  profile        MemberProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  planId         String
  plan           MembershipPlan @relation(fields: [planId], references: [id])
  payments       Payment[]

  @@index([status])
}

/// Every dollar collected, whatever the channel. This is the LTV ledger.
model Payment {
  id           String   @id @default(cuid())
  amountCents  Int
  kind         String   @default("DUES") // DUES | SIGNUP_FEE | PUNCH_PASS | RETAIL | PRIVATE_LESSON | OTHER
  status       String   @default("PAID")  // PAID | FAILED | REFUNDED
  method       String   @default("MANUAL") // MANUAL | STRIPE | CASH | CARD_TERMINAL
  description  String   @default("")
  paidAt       DateTime @default(now())
  recordedBy   String   @default("system")
  externalId   String?  @unique // Stripe invoice/charge id; also makes webhook ingestion idempotent
  createdAt    DateTime @default(now())
  profileId    String
  profile      MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  membershipId String?
  membership   Membership?   @relation(fields: [membershipId], references: [id])

  @@index([profileId, paidAt])
  @@index([status, paidAt])
}

model Program {
  id          String  @id @default(cuid())
  name        String  @unique
  description String
  color       String  @default("stone")
  templates   ClassTemplate[]
}

model ClassTemplate {
  id          String  @id @default(cuid())
  name        String
  description String
  ageGroup    String  @default("ADULTS") // ADULTS | KIDS | ALL
  level       String  @default("ALL")    // BEGINNER | ALL | COMPETITION
  capacity    Int     @default(12)
  durationMin Int     @default(60)
  gearNotes   String  @default("")
  programId   String
  program     Program @relation(fields: [programId], references: [id])
  sessions    ClassSession[]
}

model ClassSession {
  id          String   @id @default(cuid())
  startsAt    DateTime
  instructor  String
  status      String   @default("SCHEDULED") // SCHEDULED | CANCELLED
  templateId  String
  template    ClassTemplate @relation(fields: [templateId], references: [id])
  bookings    Booking[]
  trials      TrialBooking[]
  attendances Attendance[]
}

/// A lead booked into a class before they are a member, so the agent can say "you're in for
/// Wednesday 6pm" only once a row exists to back it up.
model TrialBooking {
  id        String   @id @default(cuid())
  status    String   @default("BOOKED") // BOOKED | ATTENDED | NO_SHOW | CANCELLED
  bookedBy  String   @default("agent") // "agent" or a staff name
  attendanceAt DateTime? // when a coach marked them attended/no-show; null = still unknown
  attendanceBy String   @default("")
  createdAt DateTime @default(now())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id])

  @@unique([leadId, sessionId])
}

model Booking {
  id        String   @id @default(cuid())
  status    String   @default("BOOKED") // BOOKED | WAITLISTED | CANCELLED
  createdAt DateTime @default(now())
  profileId String
  profile   MemberProfile @relation(fields: [profileId], references: [id])
  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id])

  @@unique([profileId, sessionId])
}

model Attendance {
  id         String   @id @default(cuid())
  checkedInAt DateTime @default(now())
  recordedBy String
  profileId  String
  profile    MemberProfile @relation(fields: [profileId], references: [id])
  sessionId  String
  session    ClassSession @relation(fields: [sessionId], references: [id])

  @@unique([profileId, sessionId])
}

model Milestone {
  id        String   @id @default(cuid())
  title     String
  notes     String   @default("")
  awardedAt DateTime @default(now())
  awardedBy String
  profileId String
  profile   MemberProfile @relation(fields: [profileId], references: [id])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String  @default("")
  category    String  // MOUTHGUARD | RASHGUARD | TSHIRT | SHORTS | GI | GLOVES | SHINGUARDS | OTHER
  priceCents  Int
  sizes       String  @default("") // comma-separated size options; empty = one size
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
  orders      Order[]
}

model Order {
  id         String   @id @default(cuid())
  status     String   @default("PLACED") // PLACED | READY | PICKED_UP | CANCELLED
  size       String   @default("")
  quantity   Int      @default(1)
  priceCents Int      // unit price at time of order
  createdAt  DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
}

model Lead {
  id           String   @id @default(cuid())
  fullName     String
  phone        String   @unique // E.164
  email        String?
  source       String   @default("MANUAL") // FACEBOOK_ADS | MANUAL | IMPORT | WEBSITE
  sourceRef    String?  // Facebook leadgen id, import batch, etc.
  campaign     String?
  formName     String?
  interest     String?  // program or goal the lead described
  ageGroup     String   @default("UNKNOWN") // ADULT | KID | UNKNOWN
  childName    String?
  answers      String   @default("{}") // raw intake answers as JSON
  notes        String   @default("")
  status       String   @default("NEW") // NEW | CONTACTED | ENGAGED | BOOKED | WON | LOST | UNSUBSCRIBED
  submittedAt  DateTime @default(now()) // when the lead came in (old leads keep their original date)
  firstContactedAt DateTime?
  lastOutboundAt   DateTime?
  lastInboundAt    DateTime?
  optedOutAt       DateTime?
  sequenceKey      String?
  sequenceStep     Int      @default(0) // steps already delivered
  pausedAt         DateTime?
  handoffAt        DateTime? // agent asked for a human
  handoffReason    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  messages     LeadMessage[]
  tasks        FollowUpTask[]
  events       LeadEvent[]
  insight      LeadInsight?
  profile      MemberProfile?
  trials       TrialBooking[]
  staffTouches StaffTouch[]

  @@index([status])
  @@index([createdAt])
}

model Sequence {
  id        String         @id @default(cuid())
  key       String         @unique // NEW_LEAD | REACTIVATION
  name      String
  purpose   String         @default("")
  active    Boolean        @default(true)
  steps     SequenceStep[]
}

model SequenceStep {
  id           String   @id @default(cuid())
  order        Int
  delayMinutes Int      @default(0) // delay from the previous step (0 = send immediately on enrollment)
  goal         String   @default("")
  template     String
  sequenceId   String
  sequence     Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, order])
}

model FollowUpTask {
  id          String   @id @default(cuid())
  sequenceKey String
  stepOrder   Int
  dueAt       DateTime
  status      String   @default("PENDING") // PENDING | SENT | SKIPPED | CANCELLED | FAILED
  attempts    Int      @default(0)
  lastError   String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
}

model LeadMessage {
  id         String   @id @default(cuid())
  direction  String   // OUTBOUND | INBOUND
  body       String
  status     String   @default("SENT") // SENT | FAILED | RECEIVED | DRAFT (agent reply awaiting a coach)
  provider   String   @default("MOCK") // TWILIO | MOCK
  providerId String?
  errorText  String?
  automated  Boolean  @default(false)
  agentAction String? // ANSWER | BOOK | UPSELL | HANDOFF — set when the sales agent wrote the message
  staffEdited Boolean @default(false) // staff rewrote the agent's draft before it went out
  proposedSessionId String? // class the agent offered; booked for real when the message goes out
  stepOrder  Int?
  sentBy     String?  // staff name for manual sends
  createdAt  DateTime @default(now())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model LeadEvent {
  id        String   @id @default(cuid())
  type      String   // CREATED | SMS_SENT | SMS_RECEIVED | INVESTIGATED | STATUS_CHANGED | PAUSED | RESUMED | OPTED_OUT | SEND_FAILED | CONVERTED | HANDOFF | COACH_ALERTED
  summary   String
  detail    String   @default("")
  createdAt DateTime @default(now())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model LeadInsight {
  id                  String   @id @default(cuid())
  score               Int      @default(0) // 0-100 likelihood to convert
  temperature         String   @default("WARM") // HOT | WARM | COLD
  summary             String
  intent              String   @default("")
  objections          String   @default("") // newline separated
  talkingPoints       String   @default("") // newline separated
  recommendedProgram  String   @default("")
  suggestedFirstText  String   @default("")
  generatedBy         String   @default("RULES") // AI | RULES
  model               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  leadId              String   @unique
  lead                Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model BotConfig {
  id               String  @id @default("default")
  studioName       String  @default("Atheneum Martial Arts")
  signature        String  @default("— Atheneum Martial Arts")
  timezone         String  @default("America/Chicago")
  quietHoursStart  Int     @default(21) // no automated texts at/after this local hour
  quietHoursEnd    Int     @default(8)  // ...until this local hour
  autopilot        Boolean @default(true) // send automated follow-ups
  autoReplyEnabled Boolean @default(true) // acknowledge inbound replies instantly
  bookingLink      String  @default("https://atheneummartialarts.com/trial")
  agentEnabled     Boolean @default(true) // let the sales agent write replies (needs an LLM key)
  agentMode        String  @default("DRAFT") // DRAFT (staff approves) | AUTOPILOT (sends itself)
  agentPersona     String  @default("You are Sam, the front-desk coach at the studio. Warm, direct, never pushy.")
  coachAlertPhone  String  @default("") // texted when the agent hands a lead to a human
  coachAlertHours  Int     @default(6)  // quiet window before the same lead can alert again
}

/// Everything the sales agent is allowed to claim: programs, prices, policies, objection
/// handling and upsell paths. Staff edit these, and the agent may not state a fact that is
/// not in here.
/// Money spent on a source or campaign over a period. Entered by hand — no ad platform is
/// connected — and the only input the funnel numbers cannot derive for themselves.
model AdSpend {
  id          String   @id @default(cuid())
  source      String   // matches Lead.source, e.g. FACEBOOK_ADS
  campaign    String?  // null = all spend on that source for the period
  periodStart DateTime
  periodEnd   DateTime
  amountCents Int
  note        String   @default("")
  recordedBy  String   @default("")
  createdAt   DateTime @default(now())

  @@index([source, periodStart])
}

/// Measured staff attention on a lead. Written by the lead page's activity beacon (real active
/// seconds, not a guess) and by staff actions, so "minutes per lead" is observed rather than
/// estimated.
model StaffTouch {
  id        String   @id @default(cuid())
  staffName String
  kind      String   @default("VIEW") // VIEW | REPLY | APPROVE | CALL | NOTE
  seconds   Int      @default(0)
  createdAt DateTime @default(now())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

/// A daily copy of the funnel metrics, so trends survive even though the underlying rows keep
/// changing. Written by the dispatcher tick once per studio-local day.
model MetricSnapshot {
  id         String   @id @default(cuid())
  capturedOn String   @unique // YYYY-MM-DD in studio time
  windowDays Int      @default(30)
  payload    String   // JSON blob of FunnelMetrics
  createdAt  DateTime @default(now())
}

model KnowledgeItem {
  id        String   @id @default(cuid())
  category  String   @default("FAQ") // PROGRAM | PRICING | SCHEDULE | POLICY | OBJECTION | UPSELL | FAQ
  title     String
  body      String
  audience  String   @default("ALL") // KIDS | ADULTS | ALL
  program   String   @default("") // empty = applies to every program
  active    Boolean  @default(true)
  order     Int      @default(0)
  verified  Boolean  @default(false) // false until staff confirm the numbers are real
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, active])
}

model Post {
  id        String    @id @default(cuid())
  title     String    @default("")
  body      String
  category  String    @default("GENERAL") // GENERAL | QUESTION | NEWS
  photoType String    @default("") // mime type of attached photo; empty = none
  createdAt DateTime  @default(now())
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  audience  String   @default("ALL") // ALL | ADULTS | KIDS | COMPETITION
  createdAt DateTime @default(now())
  author    String
}
